# === Server (backend) ===
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
# Bật nếu gặp lỗi "fetch failed" / SSL trên Windows (chỉ dev local)
ALLOW_INSECURE_SSL=true

# === Client (Vite - prefix VITE_) ===
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# API base URL (dev: proxy qua vite, prod: cùng domain hoặc URL riêng)
# Dev: proxy Vite → server. Production/Vercel: để trống (app dùng /api)
VITE_API_BASE_URL=http://localhost:3001
